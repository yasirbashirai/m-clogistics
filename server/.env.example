# ---- M&C Logistics checkout backend config ----
# Copy to .env and fill in. NEVER commit the real .env.

# Stripe (https://dashboard.stripe.com/apikeys)
STRIPE_SECRET_KEY=sk_live_xxx
STRIPE_WEBHOOK_SECRET=whsec_xxx          # from `stripe listen` or the Dashboard webhook

# Your public site origin (used for success/cancel URLs + CORS)
SITE_ORIGIN=https://mclogistics.delivery

# Google Distance Matrix (optional but recommended — authoritative mileage)
GOOGLE_MAPS_API_KEY=

# Shipday (optional — auto-create deliveries after payment)
SHIPDAY_API_KEY=

# SMTP for order/confirmation emails (e.g. Gmail SMTP, SendGrid, Mailgun)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=orders@mclogistics.delivery

PORT=4242
ADMIN_TOKEN=changeme123
